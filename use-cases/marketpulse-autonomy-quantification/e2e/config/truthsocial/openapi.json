{
  "openapi": "3.1.0",
  "info": {
    "title": "Local Mastodon-compatible timeline subset (NOT official Truth API)",
    "version": "2026-10-28",
    "description": "Locally authored schema from upstream Mastodon Status documentation. No claim of licensed Truth API compatibility."
  },
  "paths": {
    "/api/v1/accounts/{id}/statuses": {
      "get": {
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit", "in": "query",
            "schema": {"type": "integer", "minimum": 1, "maximum": 40, "default": 20}
          },
          {
            "name": "max_id", "in": "query",
            "schema": {"type": "string", "pattern": "^[0-9]+$"}
          },
          {
            "name": "since_id", "in": "query",
            "schema": {"type": "string", "pattern": "^[0-9]+$"}
          }
        ],
        "responses": {
          "200": {
            "description": "timeline",
            "headers": {
              "Link": {"description": "Native Mastodon rel=next pagination with max_id", "schema": {"type": "string"}}
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Status"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Status": {
        "type": "object",
        "required": [
          "id",
          "created_at",
          "content",
          "account",
          "visibility"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[0-9]+$"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "content": {
            "type": "string"
          },
          "visibility": {
            "enum": [
              "public",
              "unlisted",
              "private",
              "direct"
            ]
          },
          "account": {
            "type": "object",
            "required": [
              "id",
              "username"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "username": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  }
}
