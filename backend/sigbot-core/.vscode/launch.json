{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "type": "lldb",
            "request": "launch",
            "name": "[standalone] profiling & default config",
            "cargo": {
                "args": [
                    "build",
                    // "--features",
                    // "deadlock_detection,profiling-mem-prof,profiling-pprof,profiling-tokio-console,profiling-pyroscope"
                ],
                "filter": {
                    "name": "sigbot",
                    "kind": "bin"
                },
            },
            "env": {
                // "RUST_BACKTRACE": "full",
                "MALLOC_CONF": "prof:true,lg_prof_interval:28", // Set the stack trace sampling interval of jemalloc to bytes, e.g. 28 about is 256 MB
                "SIGBOT_CFG_VERBOSE": "false",
                //"SIGBOT_CFG_PATH": "${workspaceFolder}/etc/sigbot.yaml",
            },
            "envFile": "${workspaceFolder}/.env",
            "args": [
                "standalone", // api|deployer|datafeed|strategy|order|wallet|notification|backtest
                "--messager-provider=LOCAL",
                "--datafeed-provider=BINANCE,TRUTHSOCIAL",
                "--datafeed-configuration",
                "{\"datafeed_config\":{\"configuration\":{\"endpoint\":\"https://api.binance.com\"},\"secrets\":{\"api_secret\":\"1234567890\"}},\"messager_config\":{\"configuration\":{\"queue_size\":\"1024\"},\"secrets\":{\"api_secret\":\"1234567890\"}}}",
                "--strategy-runner-provider=PYTHON",
                "--strategy-runner-configuration",
                "",
                "--order-manager-provider=DEFAULT",
                "--order-manager-configuration",
                "",
                "--wallet-manager-provider=DEFAULT",
                "--wallet-manager-configuration",
                "",
                "--backtest-manager-provider=KLINE",
                "--backtest-manager-configuration",
                "",
                "--notification-provider=EMAIL,TELGRAME",
                "--notification-configuration",
                "",
            ],
            "cwd": "${workspaceFolder}"
        }
    ]
}