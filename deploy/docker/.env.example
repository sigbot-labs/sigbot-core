# Copy to .env (gitignored), set chmod 600, and supply actual Secret values.
POSTGRES_PASSWORD=
REDIS_PASSWORD=
MQTT_SIGNING_KEY=
MQTT_PASSWORD=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
SIGBOT_SERVICE_ENV=dev
SIGBOT_TENANT_ID=018f0000-0000-7000-8000-000000000001
SIGBOT_WORKER_NETWORK=sigbot-worker
# Host Docker socket group; `stat -c %g /var/run/docker.sock`.
DOCKER_GID=999
# Include the official Authguard adapter's trusted-context configuration here.
# The Gateway and Hosted Login require the actual business domains; see docs/runbooks/authguard-migration.md.
