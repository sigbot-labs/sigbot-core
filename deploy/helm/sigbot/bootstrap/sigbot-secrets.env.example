# Copy to a private file, replace every placeholder, and never commit it.
# Values are single-line and unquoted.
POSTGRES_PASSWORD=<POSTGRES_PASSWORD>
REDIS_PASSWORD=<REDIS_PASSWORD>
SIGBOT_SYSTEM_MASTER_KEY=<BASE64_32_BYTE_AES_KEY>

# Optional provider credentials use stable central secret keys. Add only the
# integrations enabled by a workflow.
# SIGBOT__SECRETS__VALUES__OPENAI_API_KEY=<OPENAI_API_KEY>
# SIGBOT__SECRETS__VALUES__GOOGLE_SHEETS_TOKEN=<GOOGLE_OAUTH_TOKEN>
# SIGBOT__SECRETS__VALUES__TELEGRAM_BOT_TOKEN=<TELEGRAM_BOT_TOKEN>
# SIGBOT__SECRETS__VALUES__SMTP_PASSWORD=<SMTP_PASSWORD>
# Tenant data-plane MQTT, archive, exchange and provider credentials belong in
# the independently scoped worker Secret referenced by ctl_worker.
# A Kubernetes runtime Secret or owner-only Docker env-file enabling the
# controller-managed middleware uses the typed keys below:
# SIGBOT__STORAGE__POSTGRES__PASSWORD=<TENANT_TIMESCALE_PASSWORD>
# SIGBOT__LLM__VECDB__PG_VECTOR__PASSWORD=<TENANT_PGVECTOR_PASSWORD>
# SIGBOT__CACHE__REDIS__PASSWORD=<TENANT_REDIS_PASSWORD>
# SIGBOT__SECRETS__VALUES__MQTT_PASSWORD=<TENANT_MQTT_PASSWORD>
# SIGBOT__SECRETS__VALUES__MQTT_SIGNING_KEY=<TENANT_MQTT_JWT_HMAC_KEY>
