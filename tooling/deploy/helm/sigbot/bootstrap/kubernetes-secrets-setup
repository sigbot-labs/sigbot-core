#!/usr/bin/env bash
set -euo pipefail
# Only explicitly supplied local files are read; never echo secret material.
: "${KUBECONFIG:=/etc/rancher/k3s/k3s.yaml}"
export KUBECONFIG
: "${SIGBOT_NAMESPACE:?set the target namespace}"
: "${SIGBOT_SECRET_ENV_FILE:?set the runtime Secret env file path}"
: "${AUTHGUARD_SECRET_ENV_FILE:?set the Authguard Secret env file path}"
for secret_file in "$SIGBOT_SECRET_ENV_FILE" "$AUTHGUARD_SECRET_ENV_FILE"; do
  test -s "$secret_file" || { echo 'Missing nonempty Secret input file' >&2; exit 1; }
  while IFS='=' read -r secret_key secret_value || [[ -n "$secret_key" ]]; do
    [[ -z "$secret_key" || "$secret_key" == \#* ]] && continue
    [[ "$secret_key" =~ ^[A-Z_][A-Z0-9_]*$ && -n "$secret_value" ]] || { echo 'Secret input has an invalid key or empty value' >&2; exit 1; }
  done < "$secret_file"
  unset secret_key secret_value
done
kubectl -n "$SIGBOT_NAMESPACE" create secret generic sigbot-runtime --from-env-file="$SIGBOT_SECRET_ENV_FILE" --dry-run=client -o yaml | kubectl apply -f - >/dev/null
kubectl -n "$SIGBOT_NAMESPACE" create secret generic authguard-secrets --from-env-file="$AUTHGUARD_SECRET_ENV_FILE" --dry-run=client -o yaml | kubectl apply -f - >/dev/null

if [[ -n "${SIGBOT_WORKER_SECRET_ENV_FILE:-}" ]]; then
  test -s "$SIGBOT_WORKER_SECRET_ENV_FILE" || { echo 'Worker Secret input file is missing' >&2; exit 1; }
  if rg -q '^AUTHGUARD_' "$SIGBOT_WORKER_SECRET_ENV_FILE"; then
    echo 'Worker Secret must not contain Gateway verifier keys' >&2
    exit 1
  fi
  kubectl -n "$SIGBOT_NAMESPACE" create secret generic sigbot-workers --from-env-file="$SIGBOT_WORKER_SECRET_ENV_FILE" --dry-run=client -o yaml | kubectl apply -f - >/dev/null
fi
